# Rules Service Configuration
PORT=3003

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smart_iot

# Kafka Configuration (for devices-service)
# Use port 29092 when running outside Docker (external port)
KAFKA_BROKERS=localhost:29092

# ML Service Configuration
# For local development: http://localhost:3007
# For Docker: http://ml-service:3007
ML_SERVICE_URL=http://localhost:3007
ML_SUPPORT_ENABLED=true
ML_SUPPORT_THRESHOLD=0.8
ML_SUPPORT_TIMEOUT_MS=1500

JWT_SECRET=your-strong-secret