# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smart_iot

# Kafka Configuration (for devices-service)
# Use port 29092 when running outside Docker (external port)
KAFKA_BROKERS=localhost:29092

# MQTT Configuration (from mqtt-service)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=iot

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
JWT_SECRET=your-strong-secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Device Service Configuration
DEVICE_OFFLINE_THRESHOLD_MS=60000
WATCHDOG_INTERVAL_MS=30000

# Emergency Mode Configuration
# Set to 0 to activate emergency mode immediately (no delay)
AUTO_EMERGENCY_DELAY_MS=0
EMERGENCY_AUTO_TEMP_THRESHOLD=60
EMERGENCY_AUTO_DISABLE_MS=3600000

# Kafka Configuration
KAFKA_SEND_TIMEOUT_MS=1500
KAFKA_MESSAGE_TIMEOUT_MS=4000